{
  "apiVersion": 3,
  "name": "method/advanced-grid",
  "title": "Advanced Grid",
  "description": "A flexible CSS Grid container for building complex, responsive layouts with precise control over columns, rows, and spacing.",
  "category": "method-layout-blocks",
  "supports": {
    "html": false
  },
  "attributes": {
    "highlightGrid": {
      "type": "boolean",
      "default": false
    },
    "responsiveSettings": {
      "type": "object",
      "default": {
        "base": {
          "enabled": true
        },
        "mobile": {
          "enabled": false
        },
        "tablet": {
          "enabled": false
        },
        "wide": {
          "enabled": false
        }
      }
    }
  },
  "editorScript": "file:./index.js"
}