{
    "apiVersion": 3,
    "name": "method/basic-grid",
    "title": "Method Basic Grid",
    "description": "A simple grid container for arranging items in uniform rows, with controls for items per row, alignment, and justification across breakpoints.",
    "category": "method-layout-blocks",
    "supports": {
        "html": false
    },
    "attributes": {
        "responsiveSettings": {
            "type": "object",
            "default": {
                "base": {
                    "enabled": true,
                    "gridCols": 3
                },
                "mobile": {
                    "enabled": false,
                    "gridCols": 1
                },
                "tablet": {
                    "enabled": false,
                    "gridCols": 2
                },
                "wide": {
                    "enabled": false,
                    "gridCols": 5
                }
            }
        }
    },
    "editorScript": "file:./index.js"
}