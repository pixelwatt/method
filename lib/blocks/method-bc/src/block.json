{
    "apiVersion": 3,
    "name": "method/bc",
    "title": "Method Breadcrumb",
    "description": "Displays a navigational breadcrumb trail showing the current page's position within the site hierarchy.",
    "category": "method-component-blocks",
    "supports": {
        "html": false,
        "align": [
            "full",
            "wide"
        ]
    },
    "attributes": {
        "textColor": {
            "type": "string"
        },
        "linkColor": {
            "type": "string"
        },
        "responsiveSettings": {
            "type": "object",
            "default": {
                "base": {
                    "enabled": true
                },
                "mobile": {
                    "enabled": false
                },
                "tablet": {
                    "enabled": false
                },
                "wide": {
                    "enabled": false
                }
            }
        }
    },
    "editorScript": "file:./index.js"
}