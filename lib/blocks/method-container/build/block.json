{
  "apiVersion": 3,
  "name": "method/container",
  "title": "Method Container",
  "description": "A highly versatile content block for building everything from simple wrappers to complex callouts and link blocks, with extensive controls for styling, layout, and interactivity.",
  "category": "method-layout-blocks",
  "supports": {
    "html": false,
    "align": [
      "wide",
      "full"
    ]
  },
  "attributes": {
    "bgVideo": {
      "type": "string"
    },
    "useParallax": {
      "type": "boolean",
      "default": false
    },
    "textColor": {
      "type": "string"
    },
    "linkColor": {
      "type": "string"
    },
    "bgColor": {
      "type": "string"
    },
    "bgGradient": {
      "type": "string"
    },
    "bgShadeColor": {
      "type": "string"
    },
    "bgShadeGradient": {
      "type": "string"
    },
    "bgImg": {
      "type": "object",
      "default": {
        "id": ""
      }
    },
    "bgSize": {
      "type": "string"
    },
    "bgImgAlign": {
      "type": "string",
      "default": "center center"
    },
    "link": {
      "type": "object"
    },
    "responsiveSettings": {
      "type": "object",
      "default": {
        "base": {
          "enabled": true
        },
        "mobile": {
          "enabled": false,
          "customBg": false
        },
        "tablet": {
          "enabled": false,
          "customBg": false
        },
        "wide": {
          "enabled": false,
          "customBg": false
        }
      }
    }
  },
  "editorScript": "file:./index.js"
}