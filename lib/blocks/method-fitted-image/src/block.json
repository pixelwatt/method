{
    "apiVersion": 3,
    "name": "method/fitted-image",
    "title": "Method Fitted Image",
    "description": "A container-filling image block with cover or contain fitting options, plus controls for aspect ratio, padding, background color, overlaid gradients, and linking.",
    "category": "method-component-blocks",
    "usesContext": [
        "postId"
    ],
    "supports": {
        "html": false,
        "align": [
            "full",
            "wide"
        ]
    },
    "attributes": {
        "bgColor": {
            "type": "string"
        },
        "bgGradient": {
            "type": "string"
        },
        "bgShadeColor": {
            "type": "string"
        },
        "bgShadeGradient": {
            "type": "string"
        },
        "bgImg": {
            "type": "object",
            "default": {
                "id": ""
            }
        },
        "link": {
            "type": "object"
        },
        "useFeaturedImage": {
            "type": "boolean",
            "default": false
        },
        "linkToPost": {
            "type": "boolean",
            "default": false
        },
        "responsiveSettings": {
            "type": "object",
            "default": {
                "base": {
                    "enabled": true
                },
                "mobile": {
                    "enabled": false
                },
                "tablet": {
                    "enabled": false
                },
                "wide": {
                    "enabled": false
                }
            }
        }
    },
    "editorScript": "file:./index.js"
}