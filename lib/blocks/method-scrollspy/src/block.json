{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "method/scrollspy",
	"version": "1.0.0",
	"title": "Method Scrollspy",
	"category": "method-component-blocks",
	"icon": "list-view",
	"description": "Auto-generates a sticky table of contents from headings in a sibling content area.",
	"keywords": [
		"toc",
		"table of contents",
		"scrollspy",
		"navigation",
		"docs"
	],
	"supports": {
		"html": false,
		"anchor": false,
		"multiple": false,
		"className": true
	},
	"attributes": {
		"targetSelector": {
			"type": "string",
			"default": ".docs-content"
		},
		"label": {
			"type": "string",
			"default": "On this page"
		},
		"headingLevels": {
			"type": "array",
			"default": [
				"h2",
				"h3"
			],
			"items": {
				"type": "string"
			}
		},
		"stickyOffset": {
			"type": "number",
			"default": 0
		},
		"textColor": {
			"type": "string"
		},
		"linkColor": {
			"type": "string"
		},
		"linkHoverColor": {
			"type": "string"
		},
		"linkActiveColor": {
			"type": "string"
		},
		"stickyAt": {
			"type": "string",
			"default": "md"
		}
	},
	"textdomain": "method",
	"editorScript": "file:./index.js",
	"viewScript": "file:./frontend.js"
}