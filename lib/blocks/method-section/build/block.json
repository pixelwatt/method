{
  "apiVersion": 3,
  "name": "method/section",
  "title": "Section",
  "description": "A full-width content wrapper with robust styling and layout controls, designed to define major sections of a page.",
  "category": "method-layout-blocks",
  "usesContext": [
    "postId",
    "postType"
  ],
  "supports": {
    "html": false,
    "align": [
      "full",
      "wide"
    ]
  },
  "attributes": {
    "unconstrained": {
      "type": "boolean",
      "default": false
    },
    "bgVideo": {
      "type": "string"
    },
    "useParallax": {
      "type": "boolean",
      "default": false
    },
    "textColor": {
      "type": "string"
    },
    "linkColor": {
      "type": "string"
    },
    "bgColor": {
      "type": "string"
    },
    "bgGradient": {
      "type": "string"
    },
    "bgShadeColor": {
      "type": "string"
    },
    "bgShadeGradient": {
      "type": "string"
    },
    "bgMedia": {
      "type": "string",
      "default": ""
    },
    "images": {
      "type": "array",
      "default": []
    },
    "bgImg": {
      "type": "object",
      "default": {
        "id": ""
      }
    },
    "useFeaturedImage": {
      "type": "boolean",
      "default": false
    },
    "responsiveSettings": {
      "type": "object",
      "default": {
        "base": {
          "enabled": true
        },
        "mobile": {
          "enabled": false,
          "customBg": false
        },
        "tablet": {
          "enabled": false,
          "customBg": false
        },
        "wide": {
          "enabled": false,
          "customBg": false
        }
      }
    }
  },
  "editorScript": "file:./index.js"
}