{
  "apiVersion": 3,
  "name": "method/social-nav",
  "title": "Social Nav",
  "description": "Renders an icon-based navigation menu of social media links pulled from the site's Method theme options.",
  "category": "method-component-blocks",
  "supports": {
    "html": false
  },
  "styles": [
    {
      "name": "default",
      "label": "Icons",
      "isDefault": true
    },
    {
      "name": "enclosed",
      "label": "Enclosed Icons"
    },
    {
      "name": "with-text",
      "label": "Icons with Text"
    },
    {
      "name": "enclosed-with-text",
      "label": "Enclosed Icons with Text"
    }
  ],
  "attributes": {
    "linkColor": {
      "type": "string"
    },
    "textColor": {
      "type": "string"
    },
    "bgColor": {
      "type": "string"
    },
    "bgGradient": {
      "type": "string"
    },
    "responsiveSettings": {
      "type": "object",
      "default": {
        "base": {
          "enabled": true
        },
        "mobile": {
          "enabled": false
        },
        "tablet": {
          "enabled": false
        },
        "wide": {
          "enabled": false
        }
      }
    }
  },
  "editorScript": "file:./index.js"
}